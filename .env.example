# Higgsfield API credentials — copy this file to `.env` and fill in your values.
# `.env` is gitignored; never commit real keys. This is a TEMPLATE — the values
# below are placeholders, not real credentials.
# Get a key pair at https://cloud.higgsfield.ai (API keys / developer settings).

HF_API_KEY=your_key_id_here
HF_SECRET=your_key_secret_here

# Optional overrides:
# PORT=4300                 # dashboard port
# FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
# FFPROBE_BIN=/opt/homebrew/bin/ffprobe
